# Clima Escritório (zynio): modelo do arquivo .env
#
# Copie para .env (`cp .env.example .env`), preencha e NUNCA commite o .env (ele está no .gitignore).
# O .env fica no computador do agente (Mac, PC Windows, Linux, Raspberry Pi), com permissão 600.
# Na Vercel, só as variáveis marcadas com [Vercel] (Settings → Environment Variables do projeto clima-casa).
# Detalhes de cada uma: CLAUDE.md, seção 5. Segredo que vazou: troque na hora (seção 12).

# ---------------------------------------------------------------- Supabase (banco, login, arquivos)
# Projeto "Arcondicionado". Settings → API.
# [Vercel] https://<ref>.supabase.co
SUPABASE_URL=
# [Vercel] chave pública (sb_publishable_…)
SUPABASE_PUBLISHABLE_KEY=
# [Vercel] chave secreta (sb_secret_…): só no servidor, nunca no navegador
SUPABASE_SECRET_KEY=
# [Vercel] senha do Postgres (Settings → Database)
SUPABASE_DB_PASSWORD=
# [Vercel] opcional: host do pooler (aws-…pooler.supabase.com)
SUPABASE_DB_HOST=
# [Vercel] 6543 = pooler em modo transação (o 5432 esgota as conexões)
SUPABASE_DB_PORT=6543
# token pessoal da Management API (sbp_…): schema, cron e uso. Só no agente
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------- Segurança
# [Vercel] chave AES-256 dos segredos guardados no banco. A MESMA no agente e na Vercel.
# Perdeu = reconectar Smart Life, Sinric, Alexa, Spotify e Resend
CLIMA_CHAVE_MESTRA=
# [Vercel] Cloudflare Turnstile (anti-robô do login e do portão)
TURNSTILE_SITE_KEY=
# [Vercel]
TURNSTILE_SECRET_KEY=
# [Vercel] segredo do passe do portão e da prova de trabalho (texto aleatório longo)
VERIFICACAO_SEGREDO=

# ---------------------------------------------------------------- Agente do escritório (opcionais)
# agente (padrão) ou nuvem (simula a Vercel em testes locais)
CLIMA_PAPEL=agente
# painel local do agente
CLIMA_PORTA=8090
# padrão 127.0.0.1
CLIMA_HOST=
# força o id deste computador (testes com dois agentes)
CLIMA_MAQUINA_ID=
# 1 = confiar em X-Forwarded-For (só atrás de um proxy seu)
CLIMA_CONFIAR_PROXY=
# 1 = log detalhado da Alexa (Sinric)
CLIMA_SINRIC_DEBUG=
# origens extras liberadas no CORS do site (separadas por vírgula)
CLIMA_SITE_ORIGENS=

# ---------------------------------------------------------------- Alexa e Google (Sinric Pro)
# portal.sinric.pro → Credentials. Copiadas para o banco (cifradas) na primeira execução.
SINRIC_API_KEY=
SINRIC_APP_KEY=
SINRIC_APP_SECRET=

# ---------------------------------------------------------------- Serviços usados só pelo agente
# publicar e tela Infra → Vercel. NUNCA na Vercel (escopo amplo)
VERCEL_TOKEN=
# Infra → Cloudflare (zona zynio.com.br). NUNCA na Vercel
CLOUDFLARE_API_TOKEN=
# opcional: token só leitura do repositório, para o download dos apps
GITHUB_APPS_TOKEN=
# assistente de IA no terminal (clima-ia)
NVIDIA_API_KEY=

# ---------------------------------------------------------------- Legado (transmissor único, migrado para a tabela hubs)
TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
TUYA_IP=
TUYA_VERSION=3.3
PAINEL_PORTA=8090
