{
  "expo": {
    "name": "Clima Casa",
    "slug": "clima-casa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "climacasa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.estevam5s.climacasa"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f766a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.estevam5s.climacasa"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f766a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "estevam5s",
    "description": "Controle dos ar-condicionados por infravermelho, com Alexa e Google Home.",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "14344ed0-c7fe-4785-9584-9abdb6b40070"
      }
    }
  }
}