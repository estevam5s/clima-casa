{
  "name": "clima-casa-desktop",
  "productName": "Clima Casa",
  "version": "1.6.1",
  "description": "Clima Casa para desktop: controle dos ar-condicionados, Alexa e Supabase.",
  "main": "src/main.js",
  "author": "Clima Casa",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.estevam5s.climacasa.desktop",
    "productName": "Clima Casa",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Clima Casa"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  }
}
