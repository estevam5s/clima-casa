          "nome": "Tuya",
          "protocolo": "Tuya IoT Cloud API",
          "vantagem": "Configuração simples via QR Code do app Smart Life"
        },
        "integracao_local_sem_nuvem": {
          "nome": "LocalTuya ou Tuya Local (via HACS)",
