            "Device ID (obtido na Tuya IoT Platform)",
            "Local Key (obtida na Tuya IoT Platform)"
          ],
          "envio_comandos": "Via códigos RAW em Base64 ou códigos Pronto Hex"
        }
      },
      "node_red": {
        "nodes_recomendados": [
          "node-red-contrib-tuya-smart-device",
