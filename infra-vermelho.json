      "endpoints_principais": {
        "listar_controles_virtuais": "GET /v2.0/infrareds/{infrared_id}/remotes",
        "enviar_comando_padrao": "POST /v2.0/infrareds/{infrared_id}/remotes/{remote_id}/command",
        "enviar_comando_ar_condicionado": "POST /v2.0/infrareds/{infrared_id}/air-conditioners/{remote_id}/command",
        "enviar_comando_diy": "POST /v2.0/infrareds/{infrared_id}/remotes/{remote_id}/learning-codes"
      }
